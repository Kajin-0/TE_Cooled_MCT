\@writefile{toc}{\contentsline {subsection}{\numberline {14.8}Finite-sink temperature and matched-target electrical demand}{32}{subsection.14.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Reduced nonlinear finite-sink results. Left: nominal current grid; lines retain rejected gaps. Filled/open circles indicate measured-domain/assumed-continuation legs; the lower strip shows rejected cases by sink resistance, without assigning a temperature. Right: actual power/temperature samples near the target. Open diamonds are solved nominal target endpoints, not interpolated estimates or global optima. All finite-resistance states shown require assumed above-300\,K continuation.}}{32}{figure.22}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {14.9}Sink rejection, direct wire paths and interpretation}{33}{subsection.14.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces Left: actual nominal sink rejection and hot rise, with dashed $R_\theta Q$ controls for 0.5--3\,W total sink loads; these are not new die-load simulations. Right: signed contributions to sink rejection minus terminal input at the actual 199.995--200\,K target endpoints. The negative Cu term is heat leaving the hot pad toward ambient, not negative conductivity.}}{33}{figure.23}\protected@file@percent }
