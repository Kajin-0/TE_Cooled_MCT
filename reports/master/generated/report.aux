\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Actual solved temperature on the exact stack section. Colors represent source-cell means of the P1 field. The colder upper stage and warmer hot-side solids arise from the coupled solution. The field is conditional on the assumed materials and failed spatial qualification.}}{11}{figure.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}Electrical and heat-flow fields}{12}{section.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Actual electrical potential on the conductor section. Only P, N and copper are colored. The module terminals are on the hot side; external pin links are OFF.}}{12}{figure.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Magnitude of the actual element-mean current density on the same section. Continuity is tested separately at every one of 177 interior cuts; plotting a smooth field alone is not a continuity test.}}{12}{figure.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Actual element-mean total solid heat flux, including Fourier and Peltier terms. The logarithmic scale reveals both the stack and passive conductive paths; it is not a recovered conservative boundary flux.}}{13}{figure.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Actual resolved cold ceramic, 30\,$\mu $m attach and 200\,$\mu $m die section. The small die-temperature mesh sensitivity does not certify the normal heat-flux gradients. The maximum plotted range is a visualization choice, not an uncertainty band.}}{13}{figure.9}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}Independent raw-gradient diagnostics}{13}{section.7}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {8}Cold-interface and bath evidence}{14}{section.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Actual independent raw Fourier flux on both sides of each cold contact, positive downward. The ceramic/attach mismatch is $+6.4765\%$ (FAIL); attach/MCT is $-4.6085\%$ (PASS). Different traces are numerical evidence, not an imposed contact jump.}}{14}{figure.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Actual raw outward flux on the Kovar underside before and after a separate bath-volume refinement. The cold mesh is exactly fixed. Absolute integral errors improve from 1.4963\% to 1.2914\%, both FAIL. The reference is known external input, not the bath reaction.}}{14}{figure.11}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {9}Mesh sensitivity and independent analytical benchmark}{15}{section.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Three actually completed coupled meshes. Successive die-temperature changes are 21.10 and 2.47\,mK; voltage is nonmonotone. Raw ceramic/attach error remains above 5\%. These are sensitivity data, not a rigorous whole-device grid-convergence index.}}{15}{figure.12}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {9.1}Independent analytical reference}{16}{subsection.9.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Independent three-dimensional, three-layer HeatSolver benchmark with an analytical temperature field, harmonic transverse variation and a distributed 2\,mW source. Source-face errors are 12.5, 6.25 and 3.125\%; mean-temperature errors are 1.855, 0.464 and 0.116\,mK. The finest benchmark passes its benchmark-specific preregistered checks; these do not replace the production bath criterion or qualify the coupled device.}}{16}{figure.13}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {10}Verification matrix and numerical release gates}{17}{section.10}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {11}Independent normal and transverse refinement evidence}{18}{section.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Actual cold-normal ceramic trace and second bath-normal signed outward trace, from separate genuine solved fields. The bath map belongs to the 821,458-tetrahedron normal case. It is not the later transverse field and does not depict a combined passing mesh.}}{18}{figure.14}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {11.1}Stage conservation and later bath-volume behavior}{19}{subsection.11.1}\protected@file@percent }
