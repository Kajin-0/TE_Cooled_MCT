\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Actual corrected tetrahedral mesh cut at header mid-height. Labels denote pin numbers in the modeled top-view coordinate system; the source bottom view is mirrored consistently. White mounting holes and the two-ear outline are mesh geometry, not an ellipse or an artist's reconstruction.}}{4}{figure.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}Actual solid topology and discretization}{5}{section.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Actual mesh exterior: two-ear header, nine feedthrough pins and the cooler/detector stack. No cap or window is modeled. Pin geometry is retained even though the physical external electrical links are OFF.}}{5}{figure.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Mesh and conductor connectivity}{6}{subsection.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Exact $y=0.15$\,mm tetrahedron/plane intersection of the resolved stack. Void space remains white. Lines are actual cut-element edges; no scattered triangulation bridges gaps. The two hot-side module pad faces belong to the resolved copper routing. P legs are red, N legs blue, copper ochre, ceramics ivory, attach gray and die purple.}}{6}{figure.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}Material laws, interfaces and uncertainties}{7}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Imposed conditions and exclusions}{7}{subsection.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Temperature-dependent research analog for reduced transport}{8}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces P/N active material laws used only by the reduced analog models. Solid lines lie within the measured-table domain; dashed lines and the shaded region denote the assumed 300--390\,K continuation. The three-dimensional field shown elsewhere retains the constant verification properties.}}{8}{figure.4}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Coupled field equations and solution verification}{9}{section.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Actual solved temperature on the exact stack section. Colors represent source-cell means of the P1 field. The colder upper stage and warmer hot-side solids arise from the coupled solution. The field is conditional on the assumed materials and failed spatial qualification.}}{9}{figure.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}Electrical and heat-flow fields}{10}{section.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Actual electrical potential on the conductor section. Only P, N and copper are colored. The module terminals are on the hot side; external pin links are OFF.}}{10}{figure.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Magnitude of the actual element-mean current density on the same section. Continuity is tested separately at every one of 177 interior cuts; plotting a smooth field alone is not a continuity test.}}{10}{figure.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Actual element-mean total solid heat flux, including Fourier and Peltier terms. The logarithmic scale reveals both the stack and passive conductive paths; it is not a recovered conservative boundary flux.}}{11}{figure.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Actual resolved cold ceramic, 30\,$\mu $m attach and 200\,$\mu $m die section. The small die-temperature mesh sensitivity does not certify the normal heat-flux gradients. The maximum plotted range is a visualization choice, not an uncertainty band.}}{11}{figure.9}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}Independent raw-gradient diagnostics}{11}{section.7}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {8}Cold-interface and bath evidence}{12}{section.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Actual independent raw Fourier flux on both sides of each cold contact, positive downward. The ceramic/attach mismatch is $+6.4765\%$ (FAIL); attach/MCT is $-4.6085\%$ (PASS). Different traces are numerical evidence, not an imposed contact jump.}}{12}{figure.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Actual raw outward flux on the Kovar underside before and after a separate bath-volume refinement. The cold mesh is exactly fixed. Absolute integral errors improve from 1.4963\% to 1.2914\%, both FAIL. The reference is known external input, not the bath reaction.}}{12}{figure.11}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {9}Mesh sensitivity and independent analytical benchmark}{13}{section.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Three actually completed coupled meshes. Successive die-temperature changes are 21.10 and 2.47\,mK; voltage is nonmonotone. Raw ceramic/attach error remains above 5\%. These are sensitivity data, not a rigorous whole-device grid-convergence index.}}{13}{figure.12}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {9.1}Independent analytical reference}{14}{subsection.9.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Independent three-dimensional, three-layer HeatSolver benchmark with an analytical temperature field, harmonic transverse variation and a distributed 2\,mW source. Source-face errors are 12.5, 6.25 and 3.125\%; mean-temperature errors are 1.855, 0.464 and 0.116\,mK. The finest benchmark passes its benchmark-specific preregistered checks; these do not replace the production bath criterion or qualify the coupled device.}}{14}{figure.13}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {10}Verification matrix and numerical release gates}{15}{section.10}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {11}Independent normal and transverse refinement evidence}{16}{section.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Actual cold-normal ceramic trace and second bath-normal signed outward trace, from separate genuine solved fields. The bath map belongs to the 821,458-tetrahedron normal case. It is not the later transverse field and does not depict a combined passing mesh.}}{16}{figure.14}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {11.1}Stage conservation and later bath-volume behavior}{17}{subsection.11.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {11.2}Computational method and practical cost}{17}{subsection.11.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {12}Conservative nonlinear transport and five-temperature package}{18}{section.12}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {12.1}Package, wire and load balances}{18}{subsection.12.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {12.2}Independent transport accuracy and refinement}{19}{subsection.12.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Absolute relative stage-voltage error against the independent 64-interval nonlinear reference. Stage numbering is hot to cold. The affine-temperature assumption omits Joule/Thomson-driven profile curvature; the direct nonlinear calculation substantially reduces that approximation error. These are numerical comparisons using research-specimen laws, not measurements of a device.}}{19}{figure.15}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {13}Candidate enclosure and preliminary exchange geometry}{20}{section.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Left: central $y=0.15$\,mm sections of native candidate cap/window tetrahedra and the corrected solid stack, with geometric voids retained; the flange extends outside this view. The native enclosure is a separately meshed fixture, not a conformal addition to the coupled solid field. Right: the explicitly filled stepped-core geometry used only by the preliminary exchange operator. The native surfaces and proxy surfaces are different models. Neither panel is a newly solved enclosure temperature field.}}{20}{figure.16}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {13.1}Gray radiation and pressure-dependent gas network}{21}{subsection.13.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {13.2}Ray refinement and conservative coupling}{22}{subsection.13.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Bounded proxy-ray refinement at fixed package temperatures 300/270/240/220/221\,K and 300\,K reservoirs. Left: maximum absolute correction applied to a view factor during reciprocal closure. Right: resulting die gas and radiation heat input. These are deterministic refinement diagnostics, not statistical uncertainty bands or native-cavity error estimates.}}{22}{figure.17}\protected@file@percent }
