\@writefile{toc}{\contentsline {section}{\numberline {1}Geometry and source interpretation}{2}{section.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Actual corrected tetrahedral mesh cut at header mid-height. Labels denote pin numbers in the modeled top-view coordinate system; the source bottom view is mirrored consistently. White mounting holes and the two-ear outline are mesh geometry, not an ellipse or an artist's reconstruction.}}{2}{figure.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Actual solid topology and discretization}{3}{section.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Actual mesh exterior: two-ear header, nine feedthrough pins and the cooler/detector stack. No cap or window is modeled. Pin geometry is retained even though the physical external electrical links are OFF.}}{3}{figure.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}Mesh and conductor connectivity}{4}{subsection.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Exact $y=0.15$\,mm tetrahedron/plane intersection of the resolved stack. Void space remains white. Lines are actual cut-element edges; no scattered triangulation bridges gaps. The two hot-side module pad faces belong to the resolved copper routing. P legs are red, N legs blue, copper ochre, ceramics ivory, attach gray and die purple.}}{4}{figure.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}Material laws, interfaces and uncertainties}{5}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Imposed conditions and exclusions}{5}{subsection.3.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}Coupled field equations and solution verification}{6}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Actual solved temperature on the exact stack section. Colors represent source-cell means of the P1 field. The colder upper stage and warmer hot-side solids arise from the coupled solution. The field is conditional on the assumed materials and failed spatial qualification.}}{6}{figure.4}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Electrical and heat-flow fields}{7}{section.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Actual electrical potential on the conductor section. Only P, N and copper are colored. The module terminals are on the hot side; external pin links are OFF.}}{7}{figure.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Magnitude of the actual element-mean current density on the same section. Continuity is tested separately at every one of 177 interior cuts; plotting a smooth field alone is not a continuity test.}}{7}{figure.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Actual element-mean total solid heat flux, including Fourier and Peltier terms. The logarithmic scale reveals both the stack and passive conductive paths; it is not a recovered conservative boundary flux.}}{8}{figure.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Actual resolved cold ceramic, 30\,$\mu $m attach and 200\,$\mu $m die section. The small die-temperature mesh sensitivity does not certify the normal heat-flux gradients. The maximum plotted range is a visualization choice, not an uncertainty band.}}{8}{figure.8}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}Independent raw-gradient diagnostics}{8}{section.6}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}Cold-interface and bath evidence}{9}{section.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Actual independent raw Fourier flux on both sides of each cold contact, positive downward. The ceramic/attach mismatch is $+6.4765\%$ (FAIL); attach/MCT is $-4.6085\%$ (PASS). Different traces are numerical evidence, not an imposed contact jump.}}{9}{figure.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Actual raw outward flux on the Kovar underside before and after a separate bath-volume refinement. The cold mesh is exactly fixed. Absolute integral errors improve from 1.4963\% to 1.2914\%, both FAIL. The reference is known external input, not the bath reaction.}}{9}{figure.10}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {8}Mesh sensitivity and independent analytical benchmark}{10}{section.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Three actually completed coupled meshes. Successive die-temperature changes are 21.10 and 2.47\,mK; voltage is nonmonotone. Raw ceramic/attach error remains above 5\%. These are sensitivity data, not a rigorous whole-device grid-convergence index.}}{10}{figure.11}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.1}Independent analytical reference}{11}{subsection.8.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Independent three-dimensional, three-layer HeatSolver benchmark with an analytical temperature field, harmonic transverse variation and a distributed 2\,mW source. Source-face errors are 12.5, 6.25 and 3.125\%; mean-temperature errors are 1.855, 0.464 and 0.116\,mK. The finest benchmark passes its preregistered checks; this does not qualify the coupled device.}}{11}{figure.12}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {9}Verification matrix and numerical release gates}{12}{section.9}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {9.1}Solver performance and current refinement studies}{12}{subsection.9.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {10}Subsequent independent normal-volume studies}{13}{section.10}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {10.1}Actual refined-field evidence and stage conservation}{14}{subsection.10.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Actual independent owner-gradient flux from the refined solved fields. The ceramic trace uses the cold-normal mesh; the signed bath map uses the latest completed bath or combined case, as identified in the table. These are separate field integrals; visual similarity does not establish a passing combined mesh.}}{14}{figure.13}\protected@file@percent }
