"""Genuine3D Elmer P1 recovery tests and independent quadratic-FEM references."""
import argparse,itertools,json,time
from pathlib import Path
import numpy as np
from .g2d_data import ROOT,sha,dump
from .flux_presolder_common import node_map,affine_geometry
from .flux_presolder_coupon import extrude,skin
from .fem_g1_run import execute
from .full_presolder_flux import equilibrate,p2_reference,p2_gradient,evaluate_rt0,face_geometry,QUAD,PAIRS
from .full_presolder_guard import preserve

L=.0013
angle=.45;R=np.array([[np.cos(angle),0,np.sin(angle)],[np.sin(.3)*np.sin(angle),np.cos(.3),-np.sin(.3)*np.cos(angle)],[-np.cos(.3)*np.sin(angle),np.sin(.3),np.cos(.3)*np.cos(angle)]])
K={1:17.3,2:1.,3:17.3}
C={1:0.,2:5/9*(1/17.3-1),3:5/9*(1/17.3-1)+20/9*(1-1/17.3)}


def exact_t(p,kind):
    x=p@R/L
    if kind=='oblique':
        b=np.where(x[:,2]<1/3-1e-10,1,np.where(x[:,2]<2/3-1e-10,2,3));k=np.array([K[int(v)] for v in b]);cc=np.array([C[int(v)] for v in b]);return 300+cc+5*x[:,2]**2/k+4*(x[:,0]**2-x[:,1]**2)+2*x[:,0]*x[:,1]
    return 300+4*x[:,0]+2*x[:,1]+3*x[:,2]+2*x[:,0]*x[:,1]+1.5*x[:,1]*x[:,2]


def exact_q(p,k):
    x=p@R/L;grad=np.column_stack([8*x[:,0]+2*x[:,1],-8*x[:,1]+2*x[:,0],10*x[:,2]/k]);return -(k[:,None]*grad)@R.T/L


def box(n):
    xx=np.linspace(0,1,n+1)**1.25;yy=np.linspace(0,1,n+1)**1.1;zz=np.linspace(0,1,n+1);logical=np.array(list(itertools.product(xx,yy,zz)));p=logical@R.T*L;c=[];body=[]
    def ix(a):return (a[0]*(n+1)+a[1])*(n+1)+a[2]
    for xyz in itertools.product(range(n),repeat=3):
        origin=np.array(xyz)
        for perm in itertools.permutations(range(3)):
            q=origin.copy();vertices=[ix(q)]
            for axis in perm:q=q.copy();q[axis]+=1;vertices.append(ix(q))
            if np.linalg.det(p[vertices][1:]-p[vertices][:1])<0:vertices[0],vertices[1]=vertices[1],vertices[0]
            c.append(vertices);body.append(1+min(2,int((xyz[2]+.5)*3/n)))
    return p,np.array(c),np.array(body)


def ring():
    n=32;t=np.arange(n)*2*np.pi/n;p=[[0.,0.]]
    for radius in (.00022,.00055,.0013):p.extend(np.column_stack([radius*np.cos(t),radius*np.sin(t)]))
    tri=[];b=[]
    for i in range(n):tri.append([0,1+i,1+(i+1)%n]);b.append(3)
    for level,bid in [(0,2),(1,1)]:
        a=1+level*n;d=a+n
        for i in range(n):j=(i+1)%n;tri.extend([[a+i,d+i,d+j],[a+i,d+j,a+j]]);b.extend([bid,bid])
    return np.array(p),np.array(tri),np.array(b)


def refine2(p,tri,body):
    pp=list(p);cache={};tt=[];bb=[];parents=[]
    def midpoint(a,b):
        edge=tuple(sorted((int(a),int(b))))
        if edge not in cache:cache[edge]=len(pp);pp.append((p[a]+p[b])/2)
        return cache[edge]
    for i,(a,b,c) in enumerate(tri):
        ab=midpoint(a,b);bc=midpoint(b,c);ca=midpoint(c,a)
        tt.extend([[a,ab,ca],[ab,b,bc],[ca,bc,c],[ab,bc,ca]]);bb.extend([body[i]]*4);parents.extend([i]*4)
    return np.array(pp),np.array(tt),np.array(bb),np.array(parents)


def matc(bid,kind):
    x=[]
    for j in range(3):x.append('('+'+'.join(f'({R[i,j]/L:.17g})*tx({i})' for i in range(3))+')')
    a,b,z=x
    if kind=='oblique':return f'300+({C[bid]:.17g})+({5/K[bid]:.17g})*{z}^2+4*({a}^2-{b}^2)+2*{a}*{b}'
    return f'300+4*{a}+2*{b}+3*{z}+2*{a}*{b}+1.5*{b}*{z}'


def elmer(out,p,c,b,kind):
    import meshio
    out.mkdir(parents=True,exist_ok=False);f,owner=skin(c);tags=100+b[owner];np.savez_compressed(out/'mesh.npz',points=p,cells=c,bodies=b,faces=f,tags=tags)
    meshio.write(out/'mesh.msh',meshio.Mesh(p,[('triangle',f),('tetra',c)],cell_data={'gmsh:physical':[tags,b],'gmsh:geometrical':[tags,b]}),file_format='gmsh22',binary=False);execute(['ElmerGrid','14','2','mesh.msh','-out','elmer'],out,'grid',timeout=120)
    text=f'''Header
 Mesh DB "{(out/'elmer').resolve()}" "."
End
Simulation
 Coordinate System = Cartesian 3D
 Simulation Type = Steady State
 Steady State Max Iterations = 1
 Post File = "fields.vtu"
End
Equation 1
 Active Solvers(1) = 1
End
Solver 1
 Equation = "Heat Equation"
 Variable = Temperature
 Procedure = "HeatSolve" "HeatSolver"
 Linear System Solver = Direct
 Linear System Direct Method = UMFPACK
 Nonlinear System Max Iterations = 1
End
'''
    for bid,k in K.items():
        text+=f'''Body {bid}
 Equation = 1
 Material = {bid}
 Body Force = 1
End
Material {bid}
 Heat Conductivity = Real {k}
 Density = Real 1
 Heat Capacity = Real 1
End
Boundary Condition {bid}
 Target Boundaries(1) = {100+bid}
 Temperature = Variable Coordinate 1,Coordinate 2,Coordinate 3
  Real MATC "{matc(bid,kind)}"
End
'''
    source=-10/L**2 if kind=='oblique' else 0.
    text+=f'Body Force 1\n Heat Source = Real {source:.17g}\nEnd\n';(out/'case.sif').write_text(text)
    status,_=execute(['ElmerSolver','case.sif'],out,'solver',timeout=180)
    fieldpath=sorted(out.rglob('fields*.vtu'))[-1];field=meshio.read(fieldpath);ix,_=node_map(p,field.points);t=field.point_data['temperature'].ravel()[ix]
    dump(out/'execution.json',{'solver_executed':True,'status':status,'source_sha256':{str(Path(__file__).relative_to(ROOT)):sha(Path(__file__)),str((ROOT/'tecooledmct/full_presolder_flux.py').relative_to(ROOT)):sha(ROOT/'tecooledmct/full_presolder_flux.py')},'mesh_sha256':sha(out/'mesh.npz'),'sif_sha256':sha(out/'case.sif'),'vtu_sha256':sha(fieldpath),'field_source':str(fieldpath.relative_to(out))})
    return t,source


def p2_at(reference,ids,bary):
    g=reference['tet_gradients'][ids];t=reference['temperature'][reference['cells'][ids]];gradient=np.einsum('ei,eij->ej',t[:,:4]*(4*bary-1),g)
    for j,(a,b) in enumerate(PAIRS,4):gradient+=4*t[:,j,None]*(bary[:,a,None]*g[:,b]+bary[:,b,None]*g[:,a])
    return gradient


def benchmark(out,kind):
    preserve();out.mkdir(parents=True,exist_ok=False);rows=[];previous=None
    import shutil
    snap=out/'source_snapshot';snap.mkdir()
    sources=[Path(__file__),ROOT/'tecooledmct/full_presolder_flux.py']
    hashes={str(path.relative_to(ROOT)):sha(path) for path in sources}
    for path in sources:shutil.copy2(path,snap/path.name)
    if kind=='curved':p2,tri,b2=ring()
    for level in range(3):
        if kind=='oblique':n=[3,6,12][level];p,c,b=box(n)
        else:
            if level:p2,tri,b2,parents=refine2(p2,tri,b2)
            n=[2,3,4][level];p,c,b=extrude(p2,tri,np.linspace(0,.0011,n+1),[b2]*n);p=p@R.T
        case=out/f'level_{level}';t,source=elmer(case,p,c,b,kind);k=np.array([K[int(v)] for v in b]);vol,g=affine_geometry(p,c);raw=-k[:,None]*np.einsum('ei,eij->ej',t[c],g)
        recovered=equilibrate(p,c,k,raw,np.full(len(c),source));ref=p2_reference(p,c,k,source,lambda x:exact_t(x,kind));geom=recovered;boundary=geom['count']==1;faces=geom['faces'];centres=p[faces].mean(1);owners=geom['owner'];avec=geom['area_vectors'];area=geom['area']
        bary=np.empty((len(faces),4))
        for j,ci in enumerate(owners):
            bary[j]=1/3;bary[j,np.flatnonzero(~np.isin(c[ci],faces[j]))[0]]=0
        qref=-k[owners,None]*p2_at(ref,owners,bary);reference_flux=np.einsum('ij,ij->i',qref,avec)
        norm=np.sum(reference_flux[boundary]**2/area[boundary]);raw_error=np.sqrt(np.sum((geom['raw_face_flux'][boundary]-reference_flux[boundary])**2/area[boundary])/norm);rec_error=np.sqrt(np.sum((geom['flux'][boundary]-reference_flux[boundary])**2/area[boundary])/norm)
        bottom=boundary&(abs((centres@R)[:,2])<1e-12);want=float(reference_flux[bottom].sum())
        result={'kind':kind,'level':level,'nodes':len(p),'tetrahedra':len(c),'original_raw_gate':.01,'reaction_used':False,'volume_balance_max_w':geom['max_cell_residual_w'],'reference_type':'independent conforming quadratic FEM on identical physical geometry','boundary_raw_face_mean_L2_relative':float(raw_error),'boundary_recovered_face_mean_L2_relative':float(rec_error),'raw_bottom_relative_error':float((geom['raw_face_flux'][bottom].sum()-want)/abs(want)),'recovered_bottom_relative_error':float((geom['flux'][bottom].sum()-want)/abs(want)),'P2_free_residual_l1_w':ref['free_residual_l1_w'],'global_recovered_balance_enforced_not_independent':True}
        if kind=='oblique':
            result['P2_manufactured_nodal_error_k']=float(abs(ref['temperature']-exact_t(ref['points'],kind)).max())
            error=energy=0.
            for q in QUAD:
                x=np.einsum('i,eij->ej',q,p[c]);actual=exact_q(x,k);v=evaluate_rt0(p,c,recovered,q);error+=float(vol@np.sum((v-actual)**2,axis=1)/4);energy+=float(vol@np.sum(actual**2,axis=1)/4)
            result['RT0_volume_L2_analytic_relative']=float(np.sqrt(error/energy))
        else:
            # Independent reference convergence on the bottom bath plane, with
            # parent-triangle ancestry and gradients evaluated at fine centroids.
            fids=np.flatnonzero(bottom);bytri={tuple(sorted(row)):i for i,row in enumerate(tri)};indices=np.array([bytri[tuple(row)] for row in faces[fids]])
            if previous:
                oldp,oldc,oldtri,oldgeom,oldref,oldk=previous;oldlookup={tuple(row):i for i,row in enumerate(oldgeom['faces']) if oldgeom['count'][i]==1 and abs((oldp[row].mean(0)@R)[2])<1e-12};oldf=np.array([oldlookup[tuple(sorted(oldtri[parents[i]]))] for i in indices]);oldowners=oldgeom['owner'][oldf]
                A=np.concatenate([np.ones((len(oldowners),4,1)),oldp[oldc[oldowners]]],axis=2);bb=np.einsum('ei,eij->ej',np.c_[np.ones(len(fids)),centres[fids]],np.linalg.inv(A));oldq=-oldk[oldowners,None]*p2_at(oldref,oldowners,bb);oldflux=np.einsum('ij,ij->i',oldq,avec[fids]);result['P2_bottom_Cauchy_L2_relative']=float(np.sqrt(np.sum((reference_flux[fids]-oldflux)**2/area[fids])/np.sum(reference_flux[fids]**2/area[fids])))
            previous=(p,c,tri,geom,ref,k)
        np.savez_compressed(case/'recovered_reference_fields.npz',face_nodes=faces,recovered_face_power_w=geom['flux'],raw_face_power_w=geom['raw_face_flux'],p2_reference_face_power_w=reference_flux,cell_residual_w=geom['cell_residual_w'],p2_points=ref['points'],p2_cells=ref['cells'],p2_temperature=ref['temperature'])
        dump(case/'verification.json',result);rows.append(result);print(kind,level,result,flush=True)
    qualified=(rows[-1]['boundary_recovered_face_mean_L2_relative']<.05 and abs(rows[-1]['recovered_bottom_relative_error'])<.01 and max(r['volume_balance_max_w'] for r in rows)<1e-9)
    if kind=='oblique':qualified=qualified and max(r['P2_manufactured_nodal_error_k'] for r in rows)<1e-6 and rows[-1]['RT0_volume_L2_analytic_relative']<rows[0]['RT0_volume_L2_analytic_relative']
    else:qualified=qualified and rows[-1].get('P2_bottom_Cauchy_L2_relative',1)<.01
    if any(sha(ROOT/name)!=digest for name,digest in hashes.items()):raise ValueError('Benchmark source changed')
    dump(out/'summary.json',{'benchmark_qualified':bool(qualified),'source_sha256':hashes,'full_device_raw_qualification':False,'scope':'nonuniform oblique3D material jumps' if kind=='oblique' else 'fixed32-sided chordal curved-interface geometry; true-circle geometry error separate','predeclared_criteria':{'boundary_L2':.05,'integrated_bottom':.01,'reference_Cauchy':.01,'local_balance_w':1e-9},'cases':rows})

if __name__=='__main__':
    parser=argparse.ArgumentParser();parser.add_argument('kind',choices=['oblique','curved']);parser.add_argument('--out',type=Path,required=True);a=parser.parse_args();benchmark(a.out.resolve(),a.kind)
