Check Keywords Warn
Header
  Mesh DB "/work/outputs/fem-g2c/thomson_rod" "."
End
Simulation
  Coordinate System = Cartesian 3D
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals(1) = 1
  Output File = "solution.result"
  Post File = "fields.vtu"
End
Initial Condition 1
  Temperature = Real 295.0
  Potential = Real 0
End
Body Force 1
  Heat Source = Real 0
  Current Source = Real 0
End
Equation 1
  Active Solvers(1) = 1
End
Solver 1
  Equation = "ThermoElectric"
  Variable = POT[Temperature:1 Potential:1]
  Procedure = "ThermoElectricSolver" "ThermoElectricSolver"
  Element = "p:1"
  Nonlinear System Convergence Tolerance = 1e-9
  Nonlinear System Max Iterations = 60
  Nonlinear System Newton After Iterations = 2
  Nonlinear System Newton After Tolerance = 1e-7
  Linear System Solver = Direct
  Linear System Direct Method = UMFPACK
  Linear System Row Equilibration = Logical True
  Linear System Residual Output = 1
  Steady State Convergence Tolerance = 1e-10
End
Body 1
  Target Bodies(1) = 1
  Name = "manufactured_P_rod"
  Equation = 1
  Material = 1
  Body Force = 1
  Initial Condition = 1
End
Material 1
  Heat Conductivity = Variable Temperature
    Real Procedure "/work/outputs/fem-g2c/library_thomson/G2cMaterial" "PHeat"
  Electric Conductivity = Variable Temperature
    Real Procedure "/work/outputs/fem-g2c/library_thomson/G2cMaterial" "PElectric"
  Seebeck Coefficient = Variable Temperature
    Real Procedure "/work/outputs/fem-g2c/library_thomson/G2cMaterial" "PSeebeck"
  Density = Real 7529
  Heat Capacity = Real 544
End
Material 2
  Heat Conductivity = Variable Temperature
    Real Procedure "/work/outputs/fem-g2c/library_thomson/G2cMaterial" "NHeat"
  Electric Conductivity = Variable Temperature
    Real Procedure "/work/outputs/fem-g2c/library_thomson/G2cMaterial" "NElectric"
  Seebeck Coefficient = Variable Temperature
    Real Procedure "/work/outputs/fem-g2c/library_thomson/G2cMaterial" "NSeebeck"
  Density = Real 7529
  Heat Capacity = Real 544
End
Material 3
  Heat Conductivity = Real 400
  Electric Conductivity = Real 58139534.88372093
  Seebeck Coefficient = Real 0
  Density = Real 8960
  Heat Capacity = Real 385
End
Material 4
  Heat Conductivity = Real 30
  Electric Conductivity = Real 1e-12
  Seebeck Coefficient = Real 0
  Density = Real 3900
  Heat Capacity = Real 880
End
Boundary Condition 1
  Target Boundaries(1) = 101
  Electric Flux = Real 625000
  Temperature = Real 295.0
End
Boundary Condition 2
  Target Boundaries(1) = 102
  Potential = Real 0
  Temperature = Real 285
End
