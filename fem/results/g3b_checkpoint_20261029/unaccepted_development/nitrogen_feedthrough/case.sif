Check Keywords Warn
Header
 Mesh DB "/work/outputs/fem-g3b/nitrogen_feedthrough" "."
End
Simulation
 Coordinate System = Cartesian 3D
 Simulation Type = Steady State
 Steady State Max Iterations = 1
 Output File = "solution.result"
 Post File = "fields.vtu"
End
Initial Condition 1
 Temperature = Variable Coordinate 1
  Real Procedure "/work/outputs/fem-g3b/nitrogen_feedthrough/initial_library/G3bInitial" "InitialT"
 Potential = Variable Coordinate 1
  Real Procedure "/work/outputs/fem-g3b/nitrogen_feedthrough/initial_library/G3bInitial" "InitialPhi"
End
Equation 1
 Active Solvers(1) = 1
End
Solver 1
 Equation = "ThermoElectric"
 Variable = POT[Temperature:1 Potential:1]
 Procedure = "ThermoElectricSolver" "ThermoElectricSolver"
 Element = "p:1"
 Nonlinear System Convergence Tolerance = 1e-9
 Nonlinear System Max Iterations = 60
 Nonlinear System Newton After Iterations = 2
 Nonlinear System Newton After Tolerance = 1e-7
 Linear System Solver = Direct
 Linear System Direct Method = UMFPACK
 Linear System Row Equilibration = Logical True
End
Body Force 1
 Volumetric Heat Source = Real 0
 Current Source = Real 0
End
Body Force 2
 Volumetric Heat Source = Real 16666666.666666668
 Current Source = Real 0
End
