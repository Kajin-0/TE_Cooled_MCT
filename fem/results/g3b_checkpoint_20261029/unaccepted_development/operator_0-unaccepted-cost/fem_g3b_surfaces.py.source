"""Closed actual cavity, area-weighted patches and occluded reciprocal BEM quadrature."""
import argparse,json,math,shutil
from pathlib import Path
import numpy as np
from scipy.sparse import coo_matrix
from scipy.stats import qmc
from .g2d_data import ROOT,sha,dump
from .fem_g3b_data import preserve
from .fem_g3b_exchange import ray_box_blocked,ray_pin_blocked,balanced_view_factors
from .fem_g2a import mesh_adjacency
from .fem_g1_run import execute
from .fem_g2c_mesh import verify_elmer_tetra_mapping


def build(mesh,out,patch_level=0):
    import meshio
    preserve();out.mkdir(parents=True,exist_ok=True);m=json.loads((mesh/'manifest.json').read_text());d=np.load(mesh/'mesh.npz');p,c,b,f,bt=(d[k] for k in ('points','cells','bodies','faces','boundaries'));adj=mesh_adjacency(c)
    external=np.flatnonzero(bt<1000);ef=f[external];fc=np.array([adj[tuple(sorted(v))][0] for v in ef]);owner=b[fc];xyz=p[ef];cross=np.cross(xyz[:,1]-xyz[:,0],xyz[:,2]-xyz[:,0])/2;area=np.linalg.norm(cross,axis=1);normal=cross/area[:,None];center=xyz.mean(axis=1);normal[np.einsum('ij,ij->i',normal,center-p[c[fc]].mean(axis=1))<0]*=-1
    cav=m['cavity'];selected=(center[:,2]>=cav['floor_z_m']-1e-10)&(center[:,2]<=cav['ceiling_z_m']+1e-10)&(np.linalg.norm(center[:,:2],axis=1)<=cav['radius_m']+1e-10)
    ext=external[selected];ef=ef[selected];owner=owner[selected];area=area[selected];normal=normal[selected];center=center[selected];xyz=xyz[selected];aliases=bt[ext]
    edges={}
    for tri in ef:
        for i,j in ((0,1),(1,2),(2,0)):
            e=tuple(sorted((int(tri[i]),int(tri[j]))));edges[e]=edges.get(e,0)+1
    if any(v!=2 for v in edges.values()):raise ValueError('Cavity skin has an open/nonmanifold edge')
    skin_volume=-float(np.sum(area*np.einsum('ij,ij->i',normal,center))/3);expected=math.pi*cav['radius_m']**2*(cav['ceiling_z_m']-cav['floor_z_m'])
    for body in m['bodies']:
        if body['id']<=m['original_TEC_domains'] or body['kind'] in ('hot_mount','die_attach','die','bond_pad'):expected-=body['expected_volume_m3']
        if body['kind']=='pin':expected-=math.pi*m['package_registry']['feedthroughs']['pin_radius_m']**2*m['package_registry']['feedthroughs']['pin_above_header_m']
    if abs(skin_volume/expected-1)>.01:raise ValueError('Closed skin gas-volume mismatch')
    by={v['id']:v for v in m['bodies']};groups={};h=.001 if patch_level==0 else .0007
    for k,(bid,tag,n,x) in enumerate(zip(owner,aliases,normal,center)):
        size=(.003 if patch_level==0 else .0015) if by[int(bid)]['kind'] in ('cap','window','header') else h
        key=(int(bid),int(tag),*np.rint(n/.18).astype(int).tolist(),*np.floor(x/size).astype(int).tolist());groups.setdefault(key,[]).append(k)
    patches=[];pi=np.full(len(f),-1,dtype=int);rows=[];cols=[];data=[];ns=64 if patch_level==0 else 128;random=qmc.Sobol(6,scramble=False).random_base2(int(math.log2(ns)));random=(random+.5/ns)%1
    samples=[];sample_norm=[];samples2=[];sample_norm2=[]
    for idx,(key,ids) in enumerate(groups.items()):
        ids=np.array(ids);total=float(area[ids].sum());weights=area[ids]/total;nn=np.sum(normal[ids]*weights[:,None],axis=0);nn/=np.linalg.norm(nn);cent=weights@center[ids];tri=ef[ids];nodeweight=np.zeros(len(p));np.add.at(nodeweight,tri.ravel(),np.repeat(area[ids]/3,3));nodes=np.flatnonzero(nodeweight);values=nodeweight[nodes]/total
        rows.extend([idx]*len(nodes));cols.extend(nodes.tolist());data.extend(values.tolist());pi[ext[ids]]=idx
        patches.append({'index':idx,'solver_boundary':20000+idx,'owner':key[0],'owner_name':by[key[0]]['name'],'kind':by[key[0]]['kind'],'material':by[key[0]]['material'],'original_boundary':key[1],'area_m2':total,'center_m':cent.tolist(),'normal_into_gas':nn.tolist(),'triangle_indices':ext[ids].tolist()})
        for offset,positions,norms in ((0,samples,sample_norm),(3,samples2,sample_norm2)):
            choice=ids[np.minimum(np.searchsorted(np.cumsum(weights),random[:,offset]),len(ids)-1)];u=np.sqrt(random[:,offset+1]);v=random[:,offset+2];bary=np.column_stack([1-u,u*(1-v),u*v]);positions.append(np.einsum('ij,ijk->ik',bary,xyz[choice]));norms.append(normal[choice])
    N=len(patches);a=np.array([x['area_m2'] for x in patches]);cent=np.array([x['center_m'] for x in patches]);norm=np.array([x['normal_into_gas'] for x in patches]);owners=np.array([x['owner'] for x in patches]);radius=np.array([np.linalg.norm(xyz[np.flatnonzero(pi[ext]==i)].reshape(-1,3)-cent[i],axis=1).max() for i in range(N)])
    weights=coo_matrix((data,(rows,cols)),shape=(N,len(p))).tocsr();from scipy.sparse import save_npz;save_npz(out/'weights.npz',weights)
    radii=m['package_registry']['feedthroughs']['pin_radius_m'];pins=[(*x['center_xy_m'],radii,cav['floor_z_m'],x['z_m'],x['body']) for x in m['pin_tops']]
    boxes=[box for body in m['bodies'] for box in body.get('boxes_m',[body['box_m']] if 'box_m' in body else [])]
    samples=np.array(samples);samples2=np.array(samples2);sample_norm=np.array(sample_norm);sample_norm2=np.array(sample_norm2);raw=np.zeros((N,N));distance=np.linalg.norm(cent[:,None,:]-cent[None,:,:],axis=2);np.fill_diagonal(distance,1.);positive=0;blocked_count=0;near_count=0
    for start in range(0,N,24):
        ii,jj=np.meshgrid(np.arange(start,min(start+24,N)),np.arange(N),indexing='ij');ii=ii.ravel();jj=jj.ravel();keep=ii<jj;ii,jj=ii[keep],jj[keep];delta=cent[jj]-cent[ii];dist=distance[ii,jj];direction=delta/dist[:,None];ci=np.einsum('ij,ij->i',norm[ii],direction);cj=-np.einsum('ij,ij->i',norm[jj],direction)
        near=dist<2.5*(radius[ii]+radius[jj]);keep=((ci>1e-12)&(cj>1e-12))|near;ii,jj,ci,cj,dist,near=ii[keep],jj[keep],ci[keep],cj[keep],dist[keep],near[keep];positive+=len(ii)
        far=~near
        if far.any():
            i,j=ii[far],jj[far];block=ray_box_blocked(cent[i],cent[j],boxes)|ray_pin_blocked(cent[i],cent[j],pins,None,owners[i],owners[j]);blocked_count+=int(block.sum());v=a[i]*a[j]*ci[far]*cj[far]/(np.pi*dist[far]**2);v[block]=0;raw[i,j]=v;raw[j,i]=v
        i,j=ii[near],jj[near];near_count+=len(i)
        for k in range(0,len(i),64):
            u,v=i[k:k+64],j[k:k+64];x=samples[u].reshape(-1,3);y=samples2[v].reshape(-1,3);dd=y-x;rr=np.linalg.norm(dd,axis=1);direction=dd/rr[:,None];ca=np.maximum(0,np.einsum('ij,ij->i',sample_norm[u].reshape(-1,3),direction));cb=np.maximum(0,-np.einsum('ij,ij->i',sample_norm2[v].reshape(-1,3),direction));valid=(ca>0)&(cb>0);kernel=np.zeros(len(rr))
            if valid.any():
                block=ray_box_blocked(x[valid],y[valid],boxes)|ray_pin_blocked(x[valid],y[valid],pins,None,np.repeat(owners[u],ns)[valid],np.repeat(owners[v],ns)[valid]);temp=ca[valid]*cb[valid]/(np.pi*rr[valid]**2);temp[block]=0;kernel[valid]=temp;blocked_count+=int(block.sum())
            w=a[u]*a[v]*kernel.reshape(-1,ns).mean(axis=1);raw[u,v]=w;raw[v,u]=w
        if start%240==0:print('Actual cavity BEM rows',start,'/',N,flush=True)
    fview,closure=balanced_view_factors(raw,a);w=a[:,None]*fview
    solverbt=bt.copy();solverbt[pi>=0]=20000+pi[pi>=0]
    np.savez_compressed(out/'mesh.npz',points=p,cells=c,bodies=b,faces=f,boundaries=bt,solver_boundaries=solverbt,patch_index=pi);dump(out/'manifest.json',m);dump(out/'patches.json',patches);np.savez_compressed(out/'operators.npz',areas=a,centers=cent,normals=norm,raw_exchange_m2=raw,view_factors=fview,exchange_m2=w,distance_m=distance)
    meshio.write(out/'connected.msh',meshio.Mesh(p,[('triangle',f),('tetra',c)],cell_data={'gmsh:physical':[solverbt,b],'gmsh:geometrical':[solverbt,b]}),file_format='gmsh22',binary=False)
    execute(['ElmerGrid','14','2','connected.msh','-out','elmer'],out,'grid');mapping=verify_elmer_tetra_mapping(out)
    from scipy.spatial import cKDTree
    er=np.loadtxt(out/'elmer/mesh.nodes');dd,ix=cKDTree(er[:,2:5]).query(p);nodeids=er[ix,0].astype(int);expect={tuple(sorted(nodeids[face])):int(tag) for face,tag in zip(f,solverbt)};actual={}
    for line in (out/'elmer/mesh.boundary').read_text().splitlines():
        v=list(map(int,line.split()));actual[tuple(sorted(v[5:]))]=v[1]
    if expect!=actual:raise ValueError('Elmer boundary patch mapping mismatch')
    audit={'passed':True,'patches':N,'actual_triangles':len(ef),'closed_skin_all_edge_incidence_two':True,'gas_volume_skin_m3':skin_volume,'gas_volume_analytical_m3':expected,'net_oriented_area_m2':np.sum(area[:,None]*normal,axis=0).tolist(),'closure':closure,'near_pair_count':near_count,'ray_obstruction_count':blocked_count,'quadrature_samples_per_near_pair':ns,'far_field':'centroid visibility/kernel; near fields use deterministic area-weighted6D Sobol pair quadrature','source_mesh_sha256':sha(mesh/'mesh.npz'),'mesh_sha256':sha(out/'mesh.npz'),'elmer_mapping':mapping,'actual_boundary_mapping_verified':True,'patch_level':patch_level,'source_sha256':sha(Path(__file__))};dump(out/'audit.json',audit);print(json.dumps({k:v for k,v in audit.items() if not isinstance(v,dict)},indent=2),flush=True);return audit

if __name__=='__main__':
    p=argparse.ArgumentParser();p.add_argument('--mesh',type=Path,default=Path('outputs/fem-g3b/mesh_0'));p.add_argument('--out',type=Path,default=Path('outputs/fem-g3b/operator_0'));p.add_argument('--patch-level',type=int,default=0);a=p.parse_args();build(a.mesh.resolve(),a.out.resolve(),a.patch_level)
