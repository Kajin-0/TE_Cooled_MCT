"""Independent source geometry/contact and deterministic tolerance checks.

Reads saved primitives. Does not call the V3 builder or any mesh/PDE routine.
Curved interfaces are separately checked on the imported STEP by CAD audit.
"""
import argparse
from collections import Counter,defaultdict
import json,math
from pathlib import Path

EPS=1e-9
DIELECTRIC={'Al2O3','Glass','Sapphire','EP29LPSP','ZnSe_candidate','Polyimide_candidate'}
SEMI={'P','N','pHgCdTe_PC'}
def read(p):return json.loads(Path(p).read_text())
def box_spans(a,b):return [min(a[i]+a[i+3],b[i]+b[i+3])-max(a[i],b[i]) for i in range(3)]
def bb_overlap(a,b):return min(min(a[i+3],b[i+3])-max(a[i],b[i]) for i in range(3))>=-EPS

def faces(b):
    out=[]
    if b['shape']=='boxes':
        for q in b['boxes_mm']:
            for axis in range(3):
                uv=[i for i in range(3) if i!=axis]
                for s in (0,1):out.append(dict(axis=axis,plane=q[axis]+s*q[axis+3],rect=[q[uv[0]],q[uv[1]],q[uv[0]]+q[uv[0]+3],q[uv[1]]+q[uv[1]+3]],sign=2*s-1))
    elif b['shape']=='tab':
        for p in b['parts']:
            if p['type']!='line':continue
            if abs(p['a'][1]-p['b'][1])<EPS:
                y0,y1=sorted((p['a'][0],p['b'][0]));z=p['a'][1]
                for s in (-1,1):
                    out.append(dict(axis=2,plane=z+s*b['thickness']/2,rect=[b['x']-b['width']/2,y0,b['x']+b['width']/2,y1],sign=s))
                    out.append(dict(axis=0,plane=b['x']+s*b['width']/2,rect=[y0,z-b['thickness']/2,y1,z+b['thickness']/2],sign=s))
    elif b['shape']=='wedge':
        x,y,z=b['x'],b['y'],b['z'];xx=x+b['side']*b['width']
        out +=[dict(axis=0,plane=x,rect=[y,z,y+b['length'],z+b['height']],sign=-b['side']),
               dict(axis=2,plane=z,rect=[min(x,xx),y,max(x,xx),y+b['length']],sign=-1)]
    elif b['shape'] in ('cylinder','annulus'):
        for s in (0,1):out.append(dict(axis=2,plane=b['base'][2]+s*b['height'],circle=[*b['base'][:2],b['radius'],b.get('inner_radius',0)],sign=2*s-1))
    elif b['shape']=='wire' and b['material']!='Polyimide_candidate':
        for j,p in enumerate((b['points'][0],b['points'][-1])):out.append(dict(axis=2,plane=p[2],circle=[*p[:2],b['radius'],0],sign=-1))
    return out

def face_intersection(a,b):
    if a['axis']!=b['axis'] or abs(a['plane']-b['plane'])>EPS:return None
    if 'rect' in a and 'rect' in b:
        aa,bb=a['rect'],b['rect'];lo=[max(aa[i],bb[i]) for i in (0,1)];hi=[min(aa[i],bb[i]) for i in (2,3)]
        if min(hi[i]-lo[i] for i in (0,1))<=EPS:return None
        uv=[i for i in range(3) if i!=a['axis']];p=[0.]*3;p[a['axis']]=a['plane']
        p[uv[0]],p[uv[1]]=[(lo[i]+hi[i])/2 for i in (0,1)]
        return p,(hi[0]-lo[0])*(hi[1]-lo[1])
    if 'circle' not in a:return face_intersection(b,a)
    x,y,r,inner=a['circle']
    if 'circle' in b:
        xx,yy,rr,ii=b['circle']
        if math.hypot(xx-x,yy-y)>EPS:return None
        if min(r,rr)<=max(inner,ii)+EPS:return None
        radius=(min(r,rr)+max(inner,ii))/2
        return [x+radius,y,a['plane']],math.pi*(min(r,rr)**2-max(inner,ii)**2)
    q=b['rect']
    corners=[(xx,yy) for xx in (q[0],q[2]) for yy in (q[1],q[3])]
    if inner==0 and all(math.hypot(xx-x,yy-y)<=r+EPS for xx,yy in corners):
        return [(q[0]+q[2])/2,(q[1]+q[3])/2,a['plane']],(q[2]-q[0])*(q[3]-q[1])
    if x-r<q[0]-EPS or x+r>q[2]+EPS or y-r<q[1]-EPS or y+r>q[3]+EPS:return None
    return [x+(r+inner)/2,y,a['plane']],math.pi*(r*r-inner*inner)

def graph_components(nodes,edges):
    g={n:set() for n in nodes}
    for a,b in edges:g[a].add(b);g[b].add(a)
    out=[]
    while g:
        seed=next(iter(g));todo=[seed];seen={seed}
        while todo:
            a=todo.pop()
            for b in g[a]:
                if b not in seen:seen.add(b);todo.append(b)
        out.append(seen)
        for n in seen:del g[n]
    return out

def signature_ok(volume,bbox,expected_volume,expected_bbox):
    return volume>0 and abs(volume/expected_volume-1)<=1e-7 and max(abs(x-y) for x,y in zip(bbox,expected_bbox))<=2.1e-7

def interval_clearance(nominal,losses,required):
    if any(v<0 or not math.isfinite(v) for v in [nominal,required,*losses]):raise ValueError('Invalid interval')
    result=nominal-sum(losses)
    if result<required-1e-12:raise ValueError('Worst-case clearance FAIL')
    return result

def tolerances():
    # All numerical process bounds below are selected drawing requirements.
    rows=[
        ('full_PN_pad_margin',(.50-.40)/2-(.015+.005+.005+.0025),.010,'mm;15um leg registration+5pattern+5edge+2.5half leg size'),
        ('internal_net_clearance',.58-.50-2*(.005+.005),.050,'mm;two independent pattern/edge errors'),
        ('internal_ceramic_setback',1.2-(.87+.25)-(.005+.005+.005+.005),.050,'mm;selected internal process,not externalAu rule'),
        ('tab_side_ceramic_clearance',.100-.030/2-(.010+.010+.005+.0015),.050,'mm;tab/ceramic position,size andhalf foil thickness'),
        ('minimum_bend_inner_radius',.075-.030/2-(.005+.0015),.050,'mm;selected forming/foil limits'),
        ('foot_lap_containment',(.300-.200)/2-(.010+.005+.005),.020,'mm;foot/joint positioning andoutline'),
        ('side_fillet_land_containment',(.400-.300)/2-(.015+.010+.005+.005),.010,'mm;maxfillet,registration,width andedge'),
        ('external_finish_setback',((6.4-6.1)/2)-(.010+.005+.005),.100,'mm;6.1mm exteriorfinish inside6.4mm ceramic'),
        ('mount_positive_bondline',.080-.020,.040,'mm;finished60–100um interval includes surface profile/collapse'),
        ('thermode_to_riser',2.925-.125-(2.70+.015)-(.010+.010+.005),.050,'mm;0.35x0.25mm tool footprint'),
        ('solder_hierarchy_solidus_margin',138-132,5.,'C;bridge solidusminusmaximum mounting temperature'),
        ('completed_TEC_process_limit',220-180,0.,'C;conservative source limitminusselected localjoining cap'),
        ('cap_radial_route_envelope',7.1-(5.4+.115)-(.050+.050+.050+.025),.500,'mm;selected cap/pin/route/core positional bounds;convex wire paths'),
        ('TEC_pin_joint_overlap',.20-.10-(.025+.010+.005),.050,'mm;round finite join minuswire radius andindependent registration/outline'),
        ('detector_pad_bond_foot_margin',(.20-.060)/2-(.015+.005+.0025),.025,'mm;pad/foot registration andedge limits'),
        ('Au_wire_wedge_contact_margin',(.035-.018)/2-(.003+.0025),.0025,'mm;bond-centering/foot-outline limits'),
        ('Au_bond_pair_separation',.70-2*.150-.018,.100,'mm;conservative independent route envelopes')]
    results=[dict(check=n,lower_bound=v,requirement=limit,units_and_basis=why,status='PASS' if v>=limit-1e-10 else 'FAIL') for n,v,limit,why in rows]
    stack=4*.005+3*.005+6*.001+6*.003+.030+.050
    results.append(dict(check='metallized_TEC_height',lower_bound=3.8+.004-stack,upper_bound=3.8+.004+stack,allowed=[3.65,3.95],status='PASS' if stack+.004<=.15 else 'FAIL'))
    # Mount/header and die/carrier/epoxy/metal tolerances are independent, summed.
    maxdet=1.5+.020+.00225+.0005+.080+.020+.002+.0005+3.8+stack+.002+.0005+.020+.005+.150+.010+.020+.005+.200+.010+.00265+.0005
    minroof=1.5-.020+8.6-.050-(.45+.020)
    results.append(dict(check='detector_to_roof_worst',lower_bound=minroof-maxdet,requirement=.5,status='PASS' if minroof-maxdet>.5 else 'FAIL',units_and_basis='mm;not an optical focal-plane validation'))
    results.append(dict(check='bond_loop_to_roof_worst',lower_bound=minroof-(6.15+.009+.150),requirement=.5,status='PASS' if minroof-(6.15+.009+.150)>.5 else 'FAIL',units_and_basis='mm;150um conservative stack/route envelope'))
    return results

def audit(d):
    bodies=d['bodies'];by={b['name']:b for b in bodies}
    if len(by)!=len(bodies) or len(d['legs'])!=88 or d['detector']!='p-type HgCdTe two-top-contact photoconductor;not a photovoltaic diode':raise ValueError('Identity/count/detector')
    if Counter(l['stage'] for l in d['legs'])!=Counter({0:58,1:22,2:8}):raise ValueError('Stage allocation')
    if len(d['feet'])!=7:raise ValueError('Missing formed-tab foot')
    if {b['group'] for b in bodies if 'net' in b}!=set(range(89)):raise ValueError('89 net identities')
    edges=set();witnesses=[];positive=[];ff={b['name']:faces(b) for b in bodies}
    for j,a in enumerate(bodies):
        for b in bodies[j+1:]:
            if not bb_overlap(a['bbox_mm'],b['bbox_mm']):continue
            if a['shape']==b['shape']=='boxes':
                for aa in a['boxes_mm']:
                    for bb in b['boxes_mm']:
                        if min(box_spans(aa,bb))>EPS:positive.append((a['name'],b['name']))
            found=[]
            for fa in ff[a['name']]:
                for fb in ff[b['name']]:
                    q=face_intersection(fa,fb)
                    if q:found.append((q,fa['axis']))
            if found:
                key=(a['name'],b['name']);edges.add(key)
                (point,ar),axis=max(found,key=lambda r:r[0][1])
                witnesses.append(dict(a=key[0],b=key[1],point_mm=point,area_mm2=ar,axis=axis))
    if positive:raise ValueError('Positive source-box overlap '+str(positive[:8]))
    # Header face is source contour with explicit holes. Both patches avoid all bores.
    for target,point,ar in [('header_finish_Ni',[0,0,1.5],6.1**2),('cap_shell',[7.35,0,1.5],math.pi*(7.6**2-7.1**2))]:
        key=('VIGO_reference_header',target);edges.add(key);witnesses.append(dict(a=key[0],b=key[1],point_mm=point,area_mm2=ar,axis=2))
    metals={b['name'] for b in bodies if b['material'] not in DIELECTRIC|SEMI}
    medges=[(a,b) for a,b in edges if a in metals and b in metals]
    cc=graph_components(metals,medges);allowed=[{0,'PIN1'},{88,'PIN9'},{'DET7','PIN7'},{'DET8','PIN8'}]
    for comp in cc:
        groups={by[n]['group'] for n in comp}
        if len(groups)>1 and groups not in allowed:raise ValueError('Unintended electrical short '+str(groups))
    expected_stack=[['Ti',.000075],['TiW',.000050],['Cu',.013625],['Ni',.001],['Au',.000250]]
    if [list(q) for q in d['layer_stack']]!=expected_stack:raise ValueError('Unsupported metallurgy')
    for node in list(range(89))+['CASE','COLD_FINISH']:
        hit=[c for c in cc if any(by[n]['group']==node for n in c)]
        if len(hit)!=1:raise ValueError('Disconnected physical net '+str(node))
    for node,pin in ((0,1),(88,9)):
        comp=next(c for c in cc if any(by[n]['group']==node for n in c))
        if 'pin'+str(pin) not in comp:raise ValueError('Wrong/missing TEC pin endpoint')
    for pin in (7,8):
        comp=next(c for c in cc if 'det'+str(pin)+'_Au_ohmic' in c)
        if 'pin'+str(pin) not in comp:raise ValueError('Detector bond endpoint '+str(pin)+' '+str(sorted(comp)))
    pn=[]
    for l in d['legs']:
        name=f'leg{l["index"]}_{l["polarity"]}'
        if l['polarity']!=('N' if l['index']%2==0 else 'P'):raise ValueError('P/N polarity')
        adjacent={b if a==name else a for a,b in edges if name in (a,b)}
        expected={f'solder{l["index"]}_hot',f'solder{l["index"]}_cold'}
        if adjacent!=expected:raise ValueError('PN contacts '+name+' '+str(adjacent))
        for other in expected:
            ar=max(w['area_mm2'] for w in witnesses if {w['a'],w['b']}=={name,other})
            if ar<.16-1e-10:raise ValueError('Incomplete PN face '+name)
        if {l['hot_node'],l['cold_node']}!={l['index'],l['index']+1}:raise ValueError('Series quotient wrong')
        for face in ('hot','cold'):
            sn=f'solder{l["index"]}_{face}'
            touching={b if a==sn else a for a,b in edges if sn in (a,b)}
            actual={by[v]['group'] for v in touching if v in metals and isinstance(by[v]['group'],int)}
            if actual!={l[face+'_node']}:raise ValueError('Actual solder/net ownership wrong')
        pn.extend(sorted(adjacent))
    if len(pn)!=176:raise ValueError('176 contacts')
    tt=tolerances()
    if any(r['status']!='PASS' for r in tt):raise ValueError('Worst-case tolerance FAIL '+str([r for r in tt if r['status']!='PASS']))
    # Actual explicit source-derived contacts must appear; metadata alone is insufficient.
    for q in d['explicit_contacts']:
        if (q['a'],q['b']) not in edges and (q['b'],q['a']) not in edges:raise ValueError('Missing actual contact '+str(q))
    return dict(status='PASS source contact graph/box exclusivity/selected interval requirements',body_count=len(bodies),metal_components=len(cc),P_N_contacts=len(pn),net_count=89,
        contact_edges=len(edges),electrical_edges=len(medges),witnesses=witnesses,tolerances=tt,
        complete_TEC_path='pin1→net0→88 alternating P/N legs→net88→pin9',detector='pin7→Au/Ni/Au→pHgCdTe_PC→Au/Ni/Au→pin8',
        limitations='Curved overlap/exact witness checks require imported STEP audit;no current/thermal/manufacturing capability validation',thermistor='pins5/6 vacant')

if __name__=='__main__':
    p=argparse.ArgumentParser();p.add_argument('--source-dir',type=Path,required=True);a=p.parse_args();out=a.source_dir/'contact_audit.json'
    if out.exists():raise ValueError('Preserve prior audit')
    r=audit(read(a.source_dir/'design.json'));out.write_text(json.dumps(r,indent=2)+'\n');print({k:v for k,v in r.items() if k not in ('witnesses','tolerances')})
